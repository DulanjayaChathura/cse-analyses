  "highlights": [
    {
      "icon": "🧤",
      "tone": "warn",
      "title": "Dipped Products cut to Hold",
      "figure": "Rs 71.10 vs target Rs 65",
      "text": "HNB Stockbrokers changed Dipped Products (DIPD.N0000) to Hold after a strong September quarter (profit +64.4% Y/Y, helped by a lower tax rate), because the share has run past its Rs 65 target to a 52-week high. It flags weak cash flow (receivables up, capex borrowed short-term). DIPD isn't analysed on this site."
    },
    {
      "icon": "📈",
      "tone": "up",
      "title": "Market up, foreigners sold",
      "figure": "ASPI +0.35%",
      "text": "The ASPI rose 0.35% (+73.32 points) to 21,315.84 and the S&P SL20 0.28% to 6,062.83 on Rs 1.45bn turnover. Foreigners were net sellers of Rs 138.43M (bought Rs 74M, sold Rs 213M); Glass (GLAS) +7.25%, ASIR +4.14%, MGT +4.00%."
    },
    {
      "icon": "📡",
      "tone": "down",
      "title": "Heavy foreign selling in Dialog",
      "figure": "≈ −Rs 125M",
      "text": "Dialog (DIAL.N0000) took most of the day's foreign selling, about Rs 125M read off the chart, though its price closed unchanged. The site's Dialog fair value is Rs 29.05 against a recent price around Rs 50, while HNB Stockbrokers' target is Rs 59.40 (23 Nov): still a big disagreement."
    },
    {
      "icon": "🏦",
      "tone": "info",
      "title": "Bank results split",
      "figure": "SAMP +15.4%, NTB −27.7%",
      "text": "HNB Stockbrokers' 3Q 2026 bank scorecard: Sampath, DFCC, Pan Asia and Union grew profit, while NTB, NDB, SDB and Amana fell sharply and BOC, Commercial and HNB slipped. Most banks trade at 4–6x earnings and 0.5–1.0x book."
    },
    {
      "icon": "🔥",
      "tone": "warn",
      "title": "Inflation 8.5%, IMF on 2 Dec",
      "figure": "8.5%",
      "text": "NCPI inflation rose to 8.5% in October from 8.1%; the IMF board meets on 2 December on the seventh review, which would release about $345mn. Asian markets fell sharply (Kospi −5.95%, TAIEX −7.29% at the morning snapshot)."
    }
